---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--z-midnight-950)]" style="border-top: 1px solid var(--z-midnight-800); overflow: hidden;">

  <!-- Info bar -->
  <div
    class="container-site"
    style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; padding-top: 1.5rem; padding-bottom: 1.5rem;"
  >
    <p class="font-body text-[var(--z-slate-500)]" style="font-size: 0.8rem;">
      Diseñado por <a href="https://zellety.com" class="underline hover:text-[var(--z-white)] transition-colors">Zellety</a>
    </p>
    <p class="font-body text-[var(--z-slate-500)]" style="font-size: 0.8rem;">
      Copyright &copy; {year} Zellety. Todos los derechos reservados.
    </p>
  </div>

  <!-- Wordmark gigante — llena el ancho, recortado abajo -->
  <div class="footer-wordmark" aria-hidden="true">
    <span class="font-display font-bold text-[var(--z-white)] select-none">ZELLETY</span>
  </div>

</footer>

<style>
  .footer-wordmark {
    overflow: hidden;
    line-height: 1;
    /* Muestra casi toda la letra, recorta solo la base */
    height: 17vw;
  }
  .footer-wordmark span {
    display: block;
    white-space: nowrap;
    font-size: 19.5vw;
    letter-spacing: -0.02em;
    text-align: center;
    /* GSAP controla el transform inicial vía fromTo — no CSS aquí */
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const span = document.querySelector<HTMLElement>('.footer-wordmark span');
  if (!prefersReduced && span) {
    // Set initial state so no CSS-vs-GSAP pixel conflict
    gsap.set(span, { y: 0, yPercent: 110 });

    gsap.to(span, {
      yPercent: 0,
      duration: 1.1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.footer-wordmark',
        start: 'top 95%',
        once: true,
      },
      onComplete() {
        span.style.willChange = 'auto';
      },
    });
  } else if (span) {
    // No animation — show text immediately
    gsap.set(span, { y: 0, yPercent: 0 });
  }
</script>
