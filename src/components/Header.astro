---
import NavMobile from './NavMobile.vue';
import ThemeToggle from './ThemeToggle.vue';

const navLinks = [
  { href: '/#nosotros',  label: 'Nosotros' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#works',     label: 'Portafolio' },
  { href: '/#equipo',    label: 'Equipo' },
  { href: '/#contacto',  label: 'Contacto' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="container-site flex items-center justify-between h-16 md:h-20">

    <!-- Logo -->
    <a href="/" class="focus-ring rounded-sm" aria-label="Zellety — inicio">
      <span class="font-display font-bold hdr-text" style="font-size: 1.5rem; letter-spacing: -0.01em;">Zellety</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="font-body hover:opacity-70 transition-opacity duration-200 focus-ring rounded-sm hdr-text"
          style="font-size: 1rem;"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop: Theme toggle -->
    <div class="hidden md:flex items-center hdr-toggle">
      <ThemeToggle client:load />
    </div>

    <!-- Mobile: toggle + menu -->
    <div class="flex md:hidden items-center gap-2">
      <div class="hdr-toggle">
        <ThemeToggle client:load />
      </div>
      <div class="hdr-toggle">
        <NavMobile client:load links={navLinks} />
      </div>
    </div>

  </div>
</header>

<!-- Header background on scroll -->
<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  /* ── Default (light / white background) ─────────────── */
  #site-header {
    background: transparent;
    --hdr-color: #191919;
  }

  /* ── Home: hero oscuro → texto blanco inicial ────────── */
  :global(body.dark-hero) #site-header {
    --hdr-color: #ffffff;
  }
  :global(body.dark-hero) #site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #e5e5e5;
    --hdr-color: #cc6949;
  }
  #site-header .hdr-text {
    color: var(--hdr-color);
    transition: color 0.3s ease;
  }
  #site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #e5e5e5;
    --hdr-color: #cc6949;
  }

  /* ── Dark mode ───────────────────────────────────────── */
  :global([data-theme="dark"]) #site-header {
    --hdr-color: #ffffff;
  }
  :global([data-theme="dark"]) #site-header.is-scrolled {
    background: rgba(28, 24, 20, 0.96);
    border-bottom-color: #322d26;
    --hdr-color: #ffffff;
  }

  /* ThemeToggle hereda el color */
  #site-header .hdr-toggle {
    color: var(--hdr-color) !important;
    transition: color 0.3s ease;
  }
</style>
