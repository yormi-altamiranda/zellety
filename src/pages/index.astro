---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Services from '../sections/Services.astro';
import Work from '../sections/Work.astro';
import Team from '../sections/Team.astro';
import Tools from '../sections/Tools.astro';
import Testimonials from '../sections/Testimonials.astro';
import Contact from '../sections/Contact.astro';
---

<BaseLayout title="Zellety — Diseño y Desarrollo Tech en LATAM" darkHero={true}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Zellety",
      "url": "https://zellety.com",
      "logo": "https://zellety.com/favicon.svg",
      "description": "Startup de diseño y desarrollo tech en Latinoamérica. Servicios de Web App, App Móvil, IoT, UX/UI y SaaS para founders y equipos de producto.",
      "areaServed": "LATAM",
      "foundingLocation": "Latinoamérica",
      "serviceType": ["Web App Development", "Mobile App Development", "IoT", "UX/UI Design", "SaaS Development"],
      "sameAs": []
    })}
  />
  <Hero />
  <About />
  <Services />
  <Work />
  <Team />
  <Tools />
  <Testimonials />
  <Contact />
</BaseLayout>
