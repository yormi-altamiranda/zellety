---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/storyblok';
import { getAllProjects } from '../../lib/mock-data';
import { renderRichText } from '@storyblok/astro';

interface ProjectData {
  title: string;
  summary: string;
  descriptionHtml: string;
  cover_image: { filename: string; alt: string };
  services: string[];
  tech_stack: string[];
  client_name: string;
  url: string;
  year: number;
  published_at: string;
}

interface OtherProject {
  title: string;
  link: string;
  cover_image: { filename: string; alt: string };
  services: string[];
}

interface Props {
  project: ProjectData;
  otherProjects: OtherProject[];
}

export async function getStaticPaths() {
  try {
    const stories = await getProjects();
    if (stories.length > 0) {
      const all: (ProjectData & { slug: string })[] = stories.map(s => ({
        slug: s.slug,
        title: s.content.title,
        summary: s.content.summary,
        descriptionHtml: renderRichText(s.content.description),
        cover_image: {
          filename: s.content.cover_image.filename,
          alt: s.content.cover_image.alt ?? s.content.title,
        },
        services: s.content.services,
        tech_stack: s.content.tech_stack ?? [],
        client_name: s.content.client_name ?? '',
        url: s.content.url?.url ?? '',
        year: new Date(s.published_at ?? s.created_at).getFullYear(),
        published_at: s.published_at ?? s.created_at,
      }));
      return all.map((p, i) => ({
        params: { slug: p.slug },
        props: {
          project: p,
          otherProjects: all.filter((_, j) => j !== i).slice(0, 4).map(o => ({
            title: o.title,
            link: `/projects/${o.slug}`,
            cover_image: o.cover_image,
            services: o.services,
          })),
        },
      }));
    }
  } catch {
    // fall through to mock data
  }

  const mocks = getAllProjects();
  return mocks.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: {
        title: p.title,
        summary: p.summary,
        descriptionHtml: `<p>${p.description}</p>`,
        cover_image: p.cover_image,
        services: p.services,
        tech_stack: p.tech_stack,
        client_name: p.client_name,
        url: p.url,
        year: p.year,
        published_at: p.published_at,
      } satisfies ProjectData,
      otherProjects: mocks.filter((_, j) => j !== i).slice(0, 4).map(o => ({
        title: o.title,
        link: o.link,
        cover_image: o.cover_image,
        services: o.services,
      })),
    },
  }));
}

const { project, otherProjects } = Astro.props;

const SERVICE_LABELS: Record<string, string> = {
  web_app: 'Web App',
  mobile: 'App Móvil',
  iot: 'IoT / Domótica',
  ux_ui: 'UX/UI',
  saas: 'SaaS',
};

const serviceLabel = SERVICE_LABELS[project.services[0]] ?? project.services[0];

const meta = [
  { label: 'Año',       value: String(project.year) },
  { label: 'Cliente',   value: project.client_name || '—' },
  { label: 'Categoría', value: serviceLabel },
  { label: 'Stack',     value: project.tech_stack.slice(0, 2).join(' · ') || '—' },
];
---

<BaseLayout title={`${project.title} — Zellety`} description={project.summary}>

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="project-hero" style="padding: 140px 0 0; background: var(--z-midnight-950);">
    <div class="container-site">

      <!-- Título grande -->
      <h1
        class="project-title font-display font-bold text-[var(--z-white)] uppercase text-center"
        style="font-size: clamp(3rem, 10vw, 9rem); line-height: 0.92; letter-spacing: -0.03em; margin-bottom: 2rem;"
      >
        {project.title}
      </h1>

      <!-- Divider -->
      <div style="height: 1px; background: var(--z-midnight-800);"></div>

      <!-- 3 columnas de metadata -->
      <div class="project-meta grid grid-cols-1 md:grid-cols-3">

        <!-- Categoría -->
        <div class="meta-col" style="padding: 1.5rem 0; border-right: 1px solid var(--z-midnight-800);">
          <p class="font-mono uppercase text-[var(--z-slate-500)]" style="font-size: 0.6rem; letter-spacing: 0.25em; margin-bottom: 0.5rem;">
            Categoría
          </p>
          <p class="font-display font-semibold text-[var(--z-white)] uppercase" style="font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: 0.01em;">
            {serviceLabel}
          </p>
        </div>

        <!-- Año -->
        <div class="meta-col" style="padding: 1.5rem 2rem; border-right: 1px solid var(--z-midnight-800);">
          <p class="font-mono uppercase text-[var(--z-slate-500)]" style="font-size: 0.6rem; letter-spacing: 0.25em; margin-bottom: 0.5rem;">
            Año
          </p>
          <p class="font-display font-semibold text-[var(--z-white)] uppercase" style="font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: 0.01em;">
            {project.year}
          </p>
        </div>

        <!-- Link -->
        <div class="meta-col" style="padding: 1.5rem 2rem;">
          <p class="font-mono uppercase text-[var(--z-slate-500)]" style="font-size: 0.6rem; letter-spacing: 0.25em; margin-bottom: 0.5rem;">
            Proyecto
          </p>
          {project.url ? (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link font-display font-semibold text-[var(--z-white)] uppercase inline-flex items-center gap-2 transition-colors hover:text-[var(--z-lime-400)]"
              style="font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: 0.01em;"
            >
              Ver en vivo
              <span style="font-size: 1.1em;">↗</span>
            </a>
          ) : (
            <p class="font-display font-semibold text-[var(--z-slate-500)] uppercase" style="font-size: clamp(1rem, 2vw, 1.25rem);">
              —
            </p>
          )}
        </div>
      </div>

      <!-- Divider -->
      <div style="height: 1px; background: var(--z-midnight-800);"></div>

      <!-- Descripción grande centrada -->
      <div style="padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);">
        <p
          class="project-description font-display font-bold text-[var(--z-white)] text-center mx-auto"
          style="font-size: clamp(1.5rem, 3.5vw, 2.75rem); line-height: 1.25; letter-spacing: -0.01em; max-width: 900px;"
        >
          {project.summary}
        </p>
      </div>

    </div>
  </section>

  <!-- ── Cover image full-width ────────────────────────── -->
  <div class="w-full overflow-hidden" style="max-height: 82vh;">
    <img
      src={project.cover_image.filename}
      alt={project.cover_image.alt}
      class="w-full object-cover"
      style="height: 82vh;"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- ── Metadata + Descripción + Tecnologías ──────────── -->
  <div style="background: var(--z-midnight-950);">

    <!-- 4 columnas: AÑO · CLIENTE · CATEGORÍA · STACK -->
    <div class="grid grid-cols-2 lg:grid-cols-4" style="border-bottom: 1px solid var(--z-midnight-800);">
      {meta.map((item, i) => (
        <div
          style={`padding: 2rem 2.5rem; ${i < 3 ? 'border-right: 1px solid var(--z-midnight-800);' : ''} ${i >= 2 ? 'border-top: 1px solid var(--z-midnight-800);' : ''}`}
          class="lg:[border-top:none!important]"
        >
          <p class="font-mono uppercase text-[var(--z-slate-500)] mb-3" style="font-size: 0.6rem; letter-spacing: 0.25em;">
            {item.label}
          </p>
          <p class="font-display font-bold text-[var(--z-white)] uppercase" style="font-size: clamp(1rem, 2.2vw, 1.6rem); letter-spacing: 0.01em;">
            {item.value}
          </p>
        </div>
      ))}
    </div>

    <!-- Descripción -->
    <div class="grid grid-cols-1 lg:grid-cols-4" style="border-bottom: 1px solid var(--z-midnight-800);">
      <div style="padding: 2rem 2.5rem; border-right: 1px solid var(--z-midnight-800);">
        <p class="font-mono font-bold text-[var(--z-white)] uppercase tracking-[0.2em]" style="font-size: 0.7rem;">
          Descripción
        </p>
      </div>
      <div class="lg:col-span-3 font-body text-[var(--z-slate-300)]" style="font-size: 1rem; line-height: 1.85; max-width: 680px; padding: 2rem 2.5rem;" set:html={project.descriptionHtml} />
    </div>

    <!-- Tecnologías -->
    <div class="grid grid-cols-1 lg:grid-cols-4" style="border-bottom: 1px solid var(--z-midnight-800);">
      <div style="padding: 2rem 2.5rem; border-right: 1px solid var(--z-midnight-800);">
        <p class="font-mono font-bold text-[var(--z-white)] uppercase tracking-[0.2em]" style="font-size: 0.7rem;">
          Tecnologías
        </p>
      </div>
      <div class="lg:col-span-3 flex flex-wrap gap-3" style="padding: 2rem 2.5rem;">
        {project.tech_stack.map((t) => (
          <span
            class="font-mono font-semibold text-sm px-4 py-2"
            style="background: var(--z-lime-400); color: var(--z-black);"
          >
            {t}
          </span>
        ))}
      </div>
    </div>

  </div>

  <!-- ── Otros proyectos ────────────────────────────────── -->
  <div class="bg-[var(--z-midnight-950)] overflow-hidden pt-20">

    <!-- Marquee "MÁS PROYECTOS" -->
    <div
      class="overflow-hidden mb-14"
      style="mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);"
    >
      <div class="more-marquee flex whitespace-nowrap">
        {[0, 1, 2].map(() => (
          <span
            class="font-display font-bold shrink-0 text-[var(--z-white)] uppercase"
            style="font-size: clamp(3rem, 7vw, 6.5rem); line-height: 1; letter-spacing: -0.02em; padding-right: 2rem; opacity: 0.92;"
          >
            MÁS PROYECTOS&nbsp;&nbsp;·&nbsp;&nbsp;
          </span>
        ))}
      </div>
    </div>

    <!-- Grid de proyectos -->
    <div class="container-site pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-12">
        {otherProjects.map((p) => (
          <a href={p.link} class="block group" aria-label={p.title}>
            <!-- Imagen cuadrada sin border-radius -->
            <div class="overflow-hidden mb-4" style="aspect-ratio: 4/3;">
              <img
                src={p.cover_image.filename}
                alt={p.cover_image.alt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <!-- Título + categorías -->
            <div class="flex items-start justify-between gap-6" style="padding-top: 0.75rem; border-top: 1px solid var(--z-midnight-800);">
              <h4
                class="font-display font-bold text-[var(--z-white)] group-hover:text-[var(--z-lime-400)] transition-colors"
                style="font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: -0.01em;"
              >
                {p.title}
              </h4>
              <p class="font-body font-medium text-[var(--z-lime-400)] uppercase shrink-0 text-right" style="font-size: 0.65rem; letter-spacing: 0.12em; line-height: 1.6;">
                {p.services.map((s: string) => SERVICE_LABELS[s] ?? s).join(' | ')}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>

</BaseLayout>

<style>
  .more-marquee {
    animation: more-scroll 22s linear infinite;
  }
  @keyframes more-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.333%); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    // Entrada del título
    gsap.from('.project-title', {
      opacity: 0,
      y: 60,
      duration: 0.9,
      ease: 'power3.out',
      delay: 0.15,
    });
  }
</script>
