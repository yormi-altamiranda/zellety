---
import { getServices, getHomeSettings } from '../lib/storyblok';

interface DisplayService {
  number: string;
  title: string;
  subtitle: string;
  description: string;
  href: string;
}

const FALLBACK_SERVICES: DisplayService[] = [
  { number: '/01', title: 'Web App', subtitle: 'Sites que convierten.', description: 'Corporativos, e-commerce y plataformas con Nuxt, Next y AstroJS. Rápidos, accesibles y optimizados.', href: '/services#web-app' },
  { number: '/02', title: 'App Móvil', subtitle: 'iOS y Android, un solo código.', description: 'Aplicaciones nativas con Flutter. Del prototipo al store en el menor tiempo posible.', href: '/services#mobile' },
  { number: '/03', title: 'IoT', subtitle: 'Hogares y oficinas inteligentes.', description: 'Automatización con sensores, dashboards y control remoto. Conectamos el mundo físico al digital.', href: '/services#iot' },
  { number: '/04', title: 'UX/UI', subtitle: 'Diseño que comunica.', description: 'Research, wireframes, prototipos y design systems en Figma. Cada pixel tiene un propósito.', href: '/services#ux-ui' },
  { number: '/05', title: 'SaaS', subtitle: 'Plataformas que escalan.', description: 'Multi-tenant con billing, autenticación y dashboards. Del MVP al producto que crece.', href: '/services#saas' },
];

const FALLBACK_HEADER = {
  services_label:       '//SERVICIOS',
  services_title_line1: 'Nuestros',
  services_title_line2: 'servicios',
};

const homeStory = await getHomeSettings();
const h = { ...FALLBACK_HEADER, ...(homeStory?.content ?? {}) };

let services: DisplayService[];

try {
  const stories = await getServices();
  if (stories.length > 0) {
    services = stories.map((s, i) => ({
      number: `/${String(i + 1).padStart(2, '0')}`,
      title: s.content.title,
      subtitle: '',
      description: s.content.short_desc,
      href: `/services#${s.content.slug}`,
    }));
  } else {
    throw new Error('empty');
  }
} catch {
  services = FALLBACK_SERVICES;
}
---

<section id="servicios" class="section-padding bg-[var(--z-midnight-950)]">
  <div class="container-site">

    <!-- Header -->
    <div class="mb-16">
      <p class="label-mono mb-4" style="color: var(--z-lime-400);">{h.services_label}</p>
      <h2
        class="services-title font-display font-bold text-[var(--z-white)]"
        style="font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.05;"
      >
        {h.services_title_line1}<br />{h.services_title_line2}
      </h2>
    </div>

    <!-- Lista de servicios -->
    <div>
      {services.map((service) => (
        <a href={service.href} class="service-row group block" style="border-top: 1px solid var(--z-midnight-800);">
          <div
            class="flex flex-col md:flex-row md:items-center gap-4 md:gap-0 py-8"
          >
            <!-- Número -->
            <span
              class="font-mono text-[var(--z-slate-500)] shrink-0 md:w-20"
              style="font-size: 0.7rem; letter-spacing: 0.15em;"
            >
              {service.number}
            </span>

            <!-- Título -->
            <h3
              class="font-display font-bold text-[var(--z-white)] flex-1 transition-colors duration-200 group-hover:text-[var(--z-lime-400)]"
              style="font-size: clamp(2rem, 4.5vw, 4rem); line-height: 1; letter-spacing: -0.02em;"
            >
              {service.title}
            </h3>

            <!-- Descripción -->
            <p
              class="font-body text-[var(--z-slate-300)] md:w-72 lg:w-96 shrink-0"
              style="font-size: 1.125rem; line-height: 1.65;"
            >
              {service.description}
            </p>

            <!-- Arrow -->
            <span
              class="hidden md:block font-body text-[var(--z-slate-500)] group-hover:text-[var(--z-lime-400)] transition-all duration-300 group-hover:translate-x-2 ml-8 shrink-0 text-xl"
            >
              →
            </span>
          </div>
        </a>
      ))}
      <div style="border-top: 1px solid var(--z-midnight-800);"></div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    gsap.from('.services-title', {
      clipPath: 'inset(0 100% 0 0)',
      duration: 0.8,
      ease: 'power3.inOut',
      scrollTrigger: { trigger: '.services-title', start: 'top 85%' },
    });
    gsap.from('.service-row', {
      opacity: 0,
      y: 20,
      stagger: 0.08,
      duration: 0.5,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.service-row', start: 'top 90%' },
    });
  }
</script>
