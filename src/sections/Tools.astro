---
import { getHomeSettings } from '../lib/storyblok';
import astroUrl        from '../assets/icons/astro-icon-dark.svg?url';
import nextjsUrl       from '../assets/icons/nextjs_icon_dark.svg?url';
import nuxtUrl         from '../assets/icons/nuxt.svg?url';
import figmaUrl        from '../assets/icons/figma.svg?url';
import flutterUrl      from '../assets/icons/flutter.svg?url';
import supabaseUrl     from '../assets/icons/supabase.svg?url';
import firebaseUrl     from '../assets/icons/firebase.svg?url';
import vercelUrl       from '../assets/icons/vercel_dark.svg?url';
import awsUrl          from '../assets/icons/aws_dark.svg?url';
import dockerUrl       from '../assets/icons/docker.svg?url';
import githubUrl       from '../assets/icons/github_dark.svg?url';
import framerUrl       from '../assets/icons/framer_dark.svg?url';
import cloudflareUrl   from '../assets/icons/cloudflare.svg?url';
import postgresUrl     from '../assets/icons/postgresql.svg?url';
import netlifyUrl      from '../assets/icons/netlify.svg?url';
import n8nUrl          from '../assets/icons/n8n.svg?url';

const story = await getHomeSettings();
const t = {
  tools_count:       '34+',
  tools_subtitle:    'Herramientas que dominamos',
  tools_description: 'Trabajamos con el ecosistema moderno de desarrollo y diseño. Cada herramienta está elegida por su impacto, confiabilidad y velocidad de entrega.',
  ...(story?.content ?? {}),
};

const FALLBACK_TOOLS = [
  { name: 'Next.js',    logo: nextjsUrl },
  { name: 'Nuxt',       logo: nuxtUrl },
  { name: 'Astro',      logo: astroUrl },
  { name: 'Flutter',    logo: flutterUrl },
  { name: 'Figma',      logo: figmaUrl },
  { name: 'Supabase',   logo: supabaseUrl },
  { name: 'Firebase',   logo: firebaseUrl },
  { name: 'Docker',     logo: dockerUrl },
  { name: 'GitHub',     logo: githubUrl },
  { name: 'Vercel',     logo: vercelUrl },
  { name: 'AWS',        logo: awsUrl },
  { name: 'Cloudflare', logo: cloudflareUrl },
  { name: 'PostgreSQL', logo: postgresUrl },
  { name: 'Netlify',    logo: netlifyUrl },
  { name: 'Framer',     logo: framerUrl },
  { name: 'n8n',        logo: n8nUrl },
];

const sbTools = story?.content?.tool_list;
const tools: { name: string; logo: string }[] = (sbTools && sbTools.length > 0)
  ? sbTools.map((item: any) => ({ name: item.name, logo: item.logo.filename }))
  : FALLBACK_TOOLS;

// Triplicar para que el loop luzca bien con el ancho extra que da la rotación
const tickerItems = [...tools, ...tools, ...tools];
---

<section id="herramientas" class="tools-section section-padding" style="background: #0A0F1E; overflow: hidden;">

  <!-- Texto — contenido dentro del container -->
  <div class="container-site">
    <div class="tools-text">
      <p class="label-mono mb-6" style="color: #cc6949;">//HERRAMIENTAS</p>

      <div class="tools-header-row">
        <h2
          class="tools-title font-display font-bold"
          style="font-size: clamp(3.5rem, 7vw, 7rem); line-height: 0.95; letter-spacing: -0.03em; color: #ffffff;"
        >
          {t.tools_count}
        </h2>

        <div class="tools-meta">
          <p
            class="font-display font-semibold"
            style="font-size: clamp(1.1rem, 1.8vw, 1.5rem); line-height: 1.3; margin-bottom: 0.75rem; color: #cc6949;"
          >
            {t.tools_subtitle}
          </p>
          <p
            class="font-body"
            style="font-size: 1rem; line-height: 1.75; color: #C9CED8;"
          >
            {t.tools_description}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Banda inclinada — full width, fuera del container -->
  <div class="tools-band-wrap">
    <div class="tools-band">

      <!-- Fila 1 → izquierda -->
      <div class="ticker-row">
        <div class="ticker-track track-left">
          {tickerItems.map(tool => (
            <div class="ticker-item">
              <img src={tool.logo} alt={tool.name} class="ticker-logo" loading="lazy" decoding="async" />
              <span class="ticker-name">{tool.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Fila 2 → derecha -->
      <div class="ticker-row ticker-row--mid">
        <div class="ticker-track track-right">
          {tickerItems.map(tool => (
            <div class="ticker-item">
              <img src={tool.logo} alt={tool.name} class="ticker-logo" loading="lazy" decoding="async" />
              <span class="ticker-name">{tool.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Fila 3 → izquierda más lenta -->
      <div class="ticker-row">
        <div class="ticker-track track-left" style="animation-duration: 32s;">
          {tickerItems.map(tool => (
            <div class="ticker-item">
              <img src={tool.logo} alt={tool.name} class="ticker-logo" loading="lazy" decoding="async" />
              <span class="ticker-name">{tool.name}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

</section>

<style>
  /* ── Texto ──────────────────────────────────────────────── */
  .tools-header-row {
    display: flex;
    align-items: flex-start;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .tools-title {
    flex-shrink: 0;
  }

  .tools-meta {
    padding-top: 0.5rem;
    max-width: 420px;
  }

  @media (max-width: 640px) {
    .tools-header-row {
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* ── Banda inclinada ─────────────────────────────────────── */
  .tools-band-wrap {
    margin-top: clamp(3rem, 6vw, 5rem);
    /* Sin padding horizontal — la banda llega a los bordes */
  }

  .tools-band {
    transform: rotateZ(-4deg);
    /* Más ancho que el viewport para cubrir los huecos de la rotación */
    width: calc(100% + 12vw);
    margin-left: -6vw;
    background: #0A0F1E;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.25rem 0;
  }

  /* ── Filas del ticker ────────────────────────────────────── */
  .ticker-row {
    overflow: hidden;
    position: relative;
    padding: 0.75rem 0;
  }

  .ticker-row--mid {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .ticker-track {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    width: max-content;
    will-change: transform;
  }

  .track-left  { animation: ticker-left  22s linear infinite; }
  .track-right { animation: ticker-right 28s linear infinite; }

  .tools-band:hover .ticker-track {
    animation-play-state: paused;
  }

  @keyframes ticker-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
  @keyframes ticker-right {
    0%   { transform: translateX(-33.333%); }
    100% { transform: translateX(0); }
  }

  .ticker-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 2rem;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    white-space: nowrap;
  }

  .ticker-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 1;
  }

  .ticker-name {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    color: #ffffff;
    text-transform: uppercase;
  }

  /* ── Mobile ──────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .tools-band {
      transform: rotateZ(-3deg);
      width: calc(100% + 8vw);
      margin-left: -4vw;
    }
    .ticker-item {
      gap: 0.5rem;
      padding: 0 1.25rem;
    }
    .ticker-logo {
      width: 22px;
      height: 22px;
    }
    .ticker-name {
      font-size: 0.6rem;
    }
    .ticker-row {
      padding: 0.55rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track  { animation: none; }
    .tools-band    { transform: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    gsap.from('.tools-title', {
      opacity: 0,
      y: 30,
      duration: 0.7,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.tools-title', start: 'top 85%' },
    });

  }
</script>
