---
import { getProjects, getHomeSettings } from '../lib/storyblok';
import { getAllProjects } from '../lib/mock-data';

interface DisplayProject {
  title: string;
  link: string;
  cover_image: { filename: string; alt: string };
  services: string[];
}

const FALLBACK_WORK_HEADER = {
  work_label:    '//TRABAJOS',
  work_title:    'Proyectos Seleccionados',
  work_subtitle: 'Una selección de trabajos que reflejan nuestro proceso, criterio y capacidad técnica.',
  work_cta_text: 'Ver todos los proyectos →',
  work_cta_url:  '/projects',
};

const homeStory = await getHomeSettings();
const wh = { ...FALLBACK_WORK_HEADER, ...(homeStory?.content ?? {}) };

const SERVICE_LABELS: Record<string, string> = {
  web_app: 'Web App',
  mobile:  'App Móvil',
  iot:     'IoT',
  ux_ui:   'UX/UI',
  saas:    'SaaS',
};

let projects: DisplayProject[];

try {
  const stories = await getProjects();
  if (stories.length > 0) {
    projects = stories.slice(0, 6).map(s => ({
      title: s.content.title,
      link: `/projects/${s.slug}`,
      cover_image: {
        filename: s.content.cover_image.filename,
        alt: s.content.cover_image.alt ?? s.content.title,
      },
      services: s.content.services,
    }));
  } else {
    throw new Error('empty');
  }
} catch {
  projects = getAllProjects().slice(0, 6);
}

const left  = projects.filter((_, i) => i % 2 === 0);
const right = projects.filter((_, i) => i % 2 !== 0);
---

<section id="works" class="section-padding bg-[var(--z-midnight-950)]">

  <!-- Header centrado -->
  <div class="container-site text-center mb-20">
    <p class="label-mono mb-5" style="color: var(--z-lime-400);">{wh.work_label}</p>
    <h2
      class="works-title font-display font-bold text-[var(--z-white)]"
      style="font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 1rem;"
    >
      {wh.work_title}
    </h2>
    <p class="font-body text-[var(--z-slate-300)] mx-auto mb-8" style="font-size: 1.125rem; line-height: 1.7; max-width: 480px;">
      {wh.work_subtitle}
    </p>
    <a
      href={wh.work_cta_url}
      class="font-mono text-[var(--z-slate-400)] hover:text-[var(--z-lime-400)] transition-colors"
      style="font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;"
    >
      {wh.work_cta_text}
    </a>
  </div>

  <!-- Grid 2 columnas con stagger -->
  <div class="container-site">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-0">

      <!-- Columna izquierda -->
      <div class="flex flex-col gap-5">
        {left.map((p) => (
          <a href={p.link} class="work-card block group" aria-label={p.title}>
            <!-- Imagen -->
            <div class="overflow-hidden" style="aspect-ratio: 4/3;">
              <img
                src={p.cover_image.filename}
                alt={p.cover_image.alt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <!-- Info -->
            <div style="padding: 0.85rem 0; border-top: 1px solid var(--z-midnight-800);">
              <p
                class="font-body font-medium text-[var(--z-lime-400)]"
                style="font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.35rem;"
              >
                {p.services.map((s: string) => SERVICE_LABELS[s] ?? s).join(' | ')}
              </p>
              <h3
                class="font-display font-bold text-[var(--z-white)] group-hover:text-[var(--z-lime-400)] transition-colors"
                style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); letter-spacing: -0.01em; line-height: 1.2;"
              >
                {p.title}
              </h3>
            </div>
          </a>
        ))}
      </div>

      <!-- Columna derecha — desfasada hacia abajo -->
      <div class="flex flex-col gap-5 md:mt-24">
        {right.map((p) => (
          <a href={p.link} class="work-card block group" aria-label={p.title}>
            <!-- Imagen -->
            <div class="overflow-hidden" style="aspect-ratio: 4/3;">
              <img
                src={p.cover_image.filename}
                alt={p.cover_image.alt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <!-- Info -->
            <div style="padding: 0.85rem 0; border-top: 1px solid var(--z-midnight-800);">
              <p
                class="font-body font-medium text-[var(--z-lime-400)]"
                style="font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.35rem;"
              >
                {p.services.map((s: string) => SERVICE_LABELS[s] ?? s).join(' | ')}
              </p>
              <h3
                class="font-display font-bold text-[var(--z-white)] group-hover:text-[var(--z-lime-400)] transition-colors"
                style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); letter-spacing: -0.01em; line-height: 1.2;"
              >
                {p.title}
              </h3>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    gsap.from('.works-title', {
      clipPath: 'inset(0 100% 0 0)',
      duration: 0.8,
      ease: 'power3.inOut',
      scrollTrigger: { trigger: '.works-title', start: 'top 85%' },
    });
    gsap.from('.work-card', {
      opacity: 0,
      y: 40,
      stagger: 0.1,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.work-card', start: 'top 90%' },
    });
  }
</script>
